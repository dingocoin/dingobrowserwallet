{
  "name": "dingocoin-browser-extension-wallet",
  "version": "1.0.1",
  "description": "A Dingocoin wallet in your browser",
  "private": true,
  "author": {
    "name": "The Dingocoin Project",
    "email": "admin@dingocoin.com",
    "url": "https://dingocoin.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.11.0"
  },
  "browserslist": [
    "chrome >= 88",
    "edge >= 88",
    "firefox >= 109"
  ],
  "scripts": {
    "dev:chrome": "webpack --watch --config-node-env=development --env browser=chrome",
    "dev:firefox": "webpack --watch --config-node-env=development --env browser=firefox",
    "build:chrome": "webpack --config-node-env=production --env browser=chrome",
    "build:firefox": "webpack --config-node-env=production --env browser=firefox",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome:test": "webpack --config-node-env=production --env browser=chrome --env testBuild",
    "package:release": "node scripts/package-release.mjs",
    "package:source": "node scripts/package-source.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:firefox": "npx --yes addons-linter@10.12.0 extension/firefox",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.16",
    "@noble/curves": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "bitcoinjs-lib": "git+https://github.com/rkbling/bitcoinjs-lib.git#001c194c4ab8373aa893e04bba7091f2bc471ca4",
    "bootstrap": "5.1.1",
    "browserify-cipher": "^1.0.1",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "create-hash": "^1.2.0",
    "pbkdf2": "^3.1.6",
    "process": "^0.11.10",
    "randombytes": "^2.1.0",
    "react": "^17.0.2",
    "react-bootstrap": "^2.0.4",
    "react-dom": "^17.0.2",
    "stream-browserify": "^3.0.0",
    "webextension-polyfill": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^17.0.6",
    "@types/react-dom": "^17.0.5",
    "@types/webextension-polyfill": "^0.8.2",
    "autoprefixer": "^10.6.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.10.0",
    "filemanager-webpack-plugin": "^10.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "wext-manifest-loader": "^3.0.2",
    "wext-manifest-webpack-plugin": "^1.4.1"
  }
}
